{
  "name": "mcb-server-instagram-root",
  "version": "0.1.0",
  "private": true,
  "description": "MCB Server Instagram monorepo workspace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "npm run --workspaces --if-present test",
    "lint": "npm run --workspaces --if-present lint",
    "refresh-token": "npm run --workspace=apps/mcp-server refresh-token"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
